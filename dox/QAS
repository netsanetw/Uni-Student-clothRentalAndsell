## 4. Playwright E2E Automation Test Template (JavaScript/TypeScript)

If you are using automated frameworks like **Playwright**, here is a clean template pattern:

```typescript
import { test, expect } from '@playwright/test';

test.describe('Student Reservation Flow', () => {
  test.beforeEach(async ({ page }) => {
    // 1. Authenticate & load base page
    await page.goto('http://localhost/login');
    await page.fill('input[name="email"]', 'student@univ.edu');
    await page.fill('input[name="password"]', 'SecretPassword123');
    await page.click('button[type="submit"]');
    await expect(page).toHaveURL('http://localhost/catalog');
  });

  test('TC_RENTAL_001: Successfully create a rental reservation draft', async ({ page }) => {
    // 2. Select product
    await page.click('text="Traditional Habesha Dress"');
    await expect(page.locator('h1')).toContainText('Traditional Habesha Dress');

    // 3. Select Date Range
    await page.fill('input[name="start_date"]', '2026-10-20');
    await page.fill('input[name="end_date"]', '2026-10-23');

    // 4. Submit Reservation
    await page.click('button:has-text("Reserve Rental")');

    // 5. Assertions
    const successToast = page.locator('.toast-success');
    await expect(successToast).toBeVisible();
    await expect(successToast).toContainText('Reservation request submitted');
  });
});

```

